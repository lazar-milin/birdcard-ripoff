# Before editing, read CLAUDE.md at the repo root, especially "Server".
# Copy this file to .env and fill it in. `npm start` loads .env; never commit it.

# Discord application credentials from the Developer Portal. Only needed inside
# Discord. The secret stays on the server.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Lets people play as named guests without Discord. Set to false for public hosting.
ALLOW_GUESTS=true

# Use HOST=0.0.0.0 when your hosting provider requires it, for example in a container.
HOST=127.0.0.1
PORT=3000
